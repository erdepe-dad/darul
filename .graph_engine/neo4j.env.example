# Copy to .graph_engine/neo4j.env and replace both password placeholders.
# Run scripts/deploy-neo4j.sh instead if you want a password generated automatically.
GRAPH_DB_URI=bolt://127.0.0.1:7687
GRAPH_DB_BIND_ADDRESS=127.0.0.1
GRAPH_HTTP_BIND_ADDRESS=127.0.0.1
GRAPH_DB_USER=neo4j
GRAPH_DB_PASS=replace-with-a-long-random-password
NEO4J_AUTH=neo4j/replace-with-the-same-long-random-password

# Optional settings:
# GRAPH_DB_DATABASE=neo4j
# GRAPH_DB_TIMEOUT=3
# CURRENT_REPO_NAME=my-repository
# GRAPH_ENGINE_EXCLUDES=generated,fixtures
